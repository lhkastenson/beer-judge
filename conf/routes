# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

POST    /beers                      controllers.BeerController.create()
GET     /beers                      controllers.BeerController.list()
GET     /beers/:id                  controllers.BeerController.findById(id: Long)
DELETE  /beers/:id                  controllers.BeerController.delete(id: Long)

POST    /beers/:id/judgings         controllers.JudgingController.create(id: Long)
GET     /beers/:id/judgings         controllers.JudgingController.list(id: Long)
GET     /beers/:id/score            controllers.JudgingController.score(id: Long)